# Adaptive Agentic RAG V1 - Environment Configuration
# Copy to .env and fill in values. Never commit real secrets.

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/adaptive_rag
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_PREFIX=adaptive_rag

# Embedding Provider (OpenAI-compatible)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_BATCH_SIZE=100
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3

# Generation Provider (OpenAI-compatible)
GENERATION_PROVIDER=openai
GENERATION_MODEL=gpt-4o-mini
GENERATION_API_KEY=
GENERATION_API_BASE=https://api.openai.com/v1
GENERATION_TIMEOUT_SECONDS=60
GENERATION_MAX_RETRIES=3

# Router
ROUTER_PROVIDER=llm
ROUTER_MODEL=gpt-4o-mini
ROUTER_CONFIDENCE_THRESHOLD=0.7
ROUTER_ESCALATION_ENABLED=true

# Semantic Cache
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES_PER_TENANT=10000

# Web Tool
WEB_ALLOWLIST=api.github.com,raw.githubusercontent.com,en.wikipedia.org
WEB_TIMEOUT_SECONDS=10
WEB_MAX_RETRIES=2
WEB_MAX_CONTENT_LENGTH=50000

# SQL Tool
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_ROWS=1000
SQL_ALLOWED_SCHEMAS=public

# Guardrails
GUARDRAIL_INPUT_ENABLED=true
GUARDRAIL_OUTPUT_ENABLED=true
GUARDRAIL_PII_ENABLED=true
GUARDRAIL_GROUNDEDNESS_THRESHOLD=0.7
GUARDRAIL_CITATION_COVERAGE_THRESHOLD=0.8

# Agent Budgets
AGENT_MAX_STEPS=10
AGENT_MAX_TOKENS=8000
AGENT_MAX_COST_USD=0.50
AGENT_MAX_WALL_TIME_SECONDS=120

# Phoenix Observability
PHOENIX_ENABLED=true
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=adaptive-rag
PHOENIX_REDACT_PROMPTS=true
PHOENIX_REDACT_DOCUMENTS=true
PHOENIX_REDACT_CREDENTIALS=true

# Authentication (Development)
AUTH_MODE=development
AUTH_DEV_TENANT_ID=acme
AUTH_DEV_SUBJECT_ID=user-1
AUTH_DEV_ACL=support,admin

# Ingestion
INGESTION_MAX_FILE_SIZE_MB=50
INGESTION_TEMP_DIR=/tmp/adaptive_rag_ingestion
INGESTION_CHUNK_MAX_TOKENS=512
INGESTION_CHUNK_OVERLAP_TOKENS=50

# Retrieval
RETRIEVAL_BM25_K=50
RETRIEVAL_DENSE_K=50
RETRIEVAL_FUSION_K=20
RETRIEVAL_RERANK_ENABLED=false
RETRIEVAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CONTEXT_TOKEN_BUDGET=4000